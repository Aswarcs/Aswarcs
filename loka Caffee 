<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loka Coffee - Situs Resmi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #2D1B14; /* Cokelat Tua sesuai gambar */
            background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png'); /* Efek tekstur halus */
        }
        .coffee-card {
            background-color: #F5E6D3; /* Warna krem kartu produk */
        }
        .custom-font {
            font-family: 'Georgia', serif;
        }
    </style>
</head>
<body class="text-gray-800 flex justify-center items-start min-h-screen">

    <div class="w-full max-w-md bg-[#3D2B1F] min-h-screen relative shadow-2xl flex flex-col">
        
        <header class="pt-10 pb-6 text-center">
            <div class="flex justify-center mb-2">
                <i class="fa-solid fa-mug-hot text-[#D4A373] text-6xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-[#F5E6D3] tracking-widest custom-font italic">LOKA COFFEE</h1>
        </header>

        <main class="flex-1 px-4 space-y-4 pb-24">
            
            <div class="coffee-card rounded-3xl p-3 flex items-center shadow-lg">
                <img src="https://images.unsplash.com/photo-1510707577719-af7c183f1e59?w=400" alt="Espresso" class="w-24 h-24 rounded-2xl object-cover">
                <div class="ml-4 flex-1">
                    <div class="flex justify-between">
                        <h3 class="font-bold text-lg leading-tight">Espresso Roast<br>Beans</h3>
                        <span class="text-xs font-bold text-gray-500">300</span>
                    </div>
                    <p class="text-xs text-gray-400 italic">Rich & Aromatic</p>
                    <div class="mt-2 flex justify-between items-center">
                        <span class="text-[#2D1B14] font-black">$10.00</span>
                        <button class="bg-[#7B3F00] text-white text-[10px] px-3 py-1.5 rounded-full hover:bg-black transition">
                            + Add to Cart
                        </button>
                    </div>
                </div>
            </div>

            <div class="coffee-card rounded-3xl p-3 flex items-center shadow-lg">
                <img src="https://images.unsplash.com/photo-1461023233037-2419b69b8941?w=400" alt="Cold Brew" class="w-24 h-24 rounded-2xl object-cover">
                <div class="ml-4 flex-1">
                    <div class="flex justify-between">
                        <h3 class="font-bold text-lg leading-tight">Signature Cold<br>Brew</h3>
                        <span class="text-xs font-bold text-gray-500">300</span>
                    </div>
                    <p class="text-xs text-gray-400 italic">Smooth & Bold</p>
                    <div class="mt-2 flex justify-between items-center">
                        <span class="text-[#2D1B14] font-black">$12.00</span>
                        <button class="bg-[#7B3F00] text-white text-[10px] px-3 py-1.5 rounded-full hover:bg-black transition">
                            + Add to Cart
                        </button>
                    </div>
                </div>
            </div>

            <div class="coffee-card rounded-3xl p-3 flex items-center shadow-lg">
                <img src="https://images.unsplash.com/photo-1541167760496-162955ed8a9f?w=400" alt="Latte" class="w-24 h-24 rounded-2xl object-cover">
                <div class="ml-4 flex-1">
                    <div class="flex justify-between">
                        <h3 class="font-bold text-lg leading-tight">Vanilla<br>Latte</h3>
                        <span class="text-xs font-bold text-gray-500">200</span>
                    </div>
                    <p class="text-xs text-gray-400 italic">Sweet & Creamy</p>
                    <div class="mt-2 flex justify-between items-center">
                        <span class="text-[#2D1B14] font-black">$9.50</span>
                        <button class="bg-[#7B3F00] text-white text-[10px] px-3 py-1.5 rounded-full hover:bg-black transition">
                            + Add to Cart
                        </button>
                    </div>
                </div>
            </div>

        </main>

        <nav class="fixed bottom-0 w-full max-w-md bg-[#5D4037] border-t border-[#3E2723] flex justify-around py-3 text-[#F5E6D3]">
            <div class="flex flex-col items-center">
                <i class="fa-solid fa-house text-xl"></i>
                <span class="text-[10px]">Home</span>
            </div>
            <div class="flex flex-col items-center text-gray-400">
                <i class="fa-solid fa-book-open text-xl"></i>
                <span class="text-[10px]">Menu</span>
            </div>
            <div class="flex flex-col items-center text-gray-400">
                <i class="fa-solid fa-cart-shopping text-xl"></i>
                <span class="text-[10px]">Cart</span>
            </div>
            <div class="flex flex-col items-center text-gray-400">
                <i class="fa-solid fa-user text-xl"></i>
                <span class="text-[10px]">Profile</span>
            </div>
        </nav>

    </div>

</body>
</html>
